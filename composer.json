{
    "name": "varizet/varizet-prestashop",
    "description": "Varizet payment module for PrestaShop 8. Dev tooling only: the zip ships the SDK.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Varizet\\PrestaShop\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": { "php": "8.1.0" },
        "sort-packages": true
    }
}
